# Copy to .env and fill in. .env is gitignored - never commit it.
# Every value has a working local default except ANTHROPIC_API_KEY.

# --- LLM (required for phases 3+; phase 0 hello atom supports --dry-run without it) ---
ANTHROPIC_API_KEY=
# Model tiers (ground rule 6): cheap tier for bulk extraction / synthetic data,
# strong tier for runtime agent decisions and reconciliation. Pinned for reproducible evals.
# MODEL_FAST=claude-haiku-4-5-20251001
# MODEL_REASONING=claude-sonnet-5

# --- Neo4j (docker-compose service: neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=processtwin

# --- Qdrant (docker-compose service: qdrant) ---
QDRANT_URL=http://localhost:6333

# --- Temporal (docker-compose services: temporal, temporal-ui on http://localhost:8233) ---
TEMPORAL_ADDRESS=localhost:7233

# --- Langfuse (docker-compose service: langfuse, UI at http://localhost:3000) ---
# These match the LANGFUSE_INIT_* values in docker-compose.yml, so tracing works
# immediately after `make up` with zero clicks. Local-only keys - meaningless outside
# your machine. If your Langfuse image ignores INIT vars, log into the UI
# (dev@local.dev / processtwin123), create a project + API keys, and paste them here.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
