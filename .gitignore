# secrets, never committed. .env.example documents every variable.
.env

# python
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# data fetched or produced locally, never committed. Raw policy downloads are re-fetched
# with checksum verification (scripts/fetch_policies.py). FATF-derived processed clauses
# are regenerated locally for copyright reasons, see docs/architecture.md.
data/policies/raw/*
!data/policies/raw/.gitkeep
data/policies/processed/fatf_*.jsonl

# runtime artifacts
data/audit/*
!data/audit/.gitkeep
data/dead_letter/*
!data/dead_letter/.gitkeep
reports/

# local scaffolding, useful on this machine but noise in a public repo
RUN-THIS.md
publish.ps1
fix-identity.ps1
fix_dashes.py
strip_spec_refs.py
fix_typography.py

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
